# Copy to .env.local (not committed) and adjust.
# Unset, the app uses a backend on your computer: localhost on web and
# 10.0.2.2 on the Android emulator. A real tablet needs your computer's
# network address or the deployed server. Rebuild the Android app after changing it.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api

# Optional: start the app's clock at this time (it then runs forward normally),
# to check night mode or a schedule without waiting. Leave unset for real time.
# EXPO_PUBLIC_FAKE_TIME=2026-10-03T21:30:00
