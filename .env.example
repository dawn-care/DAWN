# Copy to .env (gitignored) and fill in. Docker Compose reads .env automatically
# and substitutes these into docker-compose.yml / docker-compose.dev.yml.

# Weather widget — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# News widget — https://newsapi.org
NEWS_API_KEY=

# Sign-in code emails (SMTP). Required in production: the server does not start without them.
# Leave all of these empty in development and the server prints the email, with its code, in the
# server log instead of sending it. The project sends from its team Gmail account: smtp.gmail.com,
# port 587, the account's address, and an app password from myaccount.google.com/apppasswords
# (not the account's sign-in password). Port 587 (STARTTLS) or 465 (TLS); the server refuses to
# send without TLS, in development too. Set SMTP_USER and SMTP_PASS together or not at all.
SMTP_HOST=
SMTP_PORT=
SMTP_USER= # the sending email address
SMTP_PASS= # for Gmail, the 16-character app password with no spaces
# The sender. With Gmail, use the same address as SMTP_USER: D.A.W.N. <team-address@gmail.com>
SMTP_FROM=

# Sign-in code secret — a random string of at least 32 characters. Sign-in codes and IP
# addresses are stored hashed with it, so keep it private and do not change it while codes are
# live. Required in production: the server does not start without it. Leave empty in
# development: docker-compose.dev.yml has a local-only default, and a direct `go run` with
# RUN_MODE=dev makes a random one for that run (codes then stop working on a restart). Make one
# in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
LOGIN_CODE_SECRET=

# Google sign-in — OAuth web client ID (public, not a secret). Must match
# VITE_GOOGLE_CLIENT_ID in caregiver/.env.development.
GOOGLE_CLIENT_ID=445900561007-hl23minb4tbb8r8tgm4njqdoaibet22k.apps.googleusercontent.com
