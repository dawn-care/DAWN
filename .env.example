# Copy to .env (gitignored) and fill in. Docker Compose reads .env automatically
# and substitutes these into docker-compose.yml / docker-compose.dev.yml.

# Weather widget — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# News widget — https://newsapi.org
NEWS_API_KEY=

# Sign-in code emails (SMTP) — leave all of these empty in development: docker-compose.dev.yml
# then sends to the Mailpit inbox at http://localhost:8025. For a real mail server, use your
# email provider's SMTP settings. Port 587 (STARTTLS) or 465 (TLS); the server refuses to send
# without TLS. Set SMTP_USER and SMTP_PASS together or not at all.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The sender, for example: D.A.W.N. <no-reply@your-domain.org>
SMTP_FROM=

# Sign-in code secret — a random string of at least 32 characters. Sign-in codes and IP
# addresses are stored hashed with it, so keep it private and do not change it while codes are
# live. Leave empty in development (docker-compose.dev.yml has a local-only default). Required
# in production, or sign-in by email stays off. Make one in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
LOGIN_CODE_SECRET=

# Google sign-in — OAuth web client ID (public, not a secret). Must match
# VITE_GOOGLE_CLIENT_ID in caregiver/.env.development.
GOOGLE_CLIENT_ID=445900561007-hl23minb4tbb8r8tgm4njqdoaibet22k.apps.googleusercontent.com
