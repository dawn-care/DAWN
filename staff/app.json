{
  "expo": {
    "name": "DAWN Staff",
    "slug": "dawn-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dawnstaff",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.dawncare.staff"
    },
    "android": {
      "package": "org.dawncare.staff",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
