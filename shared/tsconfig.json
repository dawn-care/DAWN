{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "typeRoots": ["../carepartner/node_modules/@types"],
    "types": ["jest"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
